NODE_ENV=production
PORT=5000
HOST=0.0.0.0

DATABASE_URL=postgresql://user:password@postgres:5432/sarathi_ai?connection_limit=10
DB_POOL_MIN=2
DB_POOL_MAX=20

JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=1d

CORS_ORIGIN=https://your-domain.com
CORS_CREDENTIALS=true

REDIS_URL=redis://redis:6379

RATE_LIMIT_MAX=100
RATE_LIMIT_AI_MAX=20

LOG_LEVEL=info
LOG_DIR=/var/log/sarathi

OLLAMA_URL=http://ollama:11434/api/generate
STORAGE_ROOT=/data/storage

JOBS_ENABLED=true

# ESIPF — Enterprise Security, IP Protection & Anti-Reverse Engineering
ENCRYPTION_KEY=REPLACE_WITH_STRONG_ENCRYPTION_KEY
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_TOKEN_TTL_MS=2592000000
LOGIN_RATE_LIMIT_MAX=10
ESIPF_HTTPS_ONLY=true
ESIPF_CSRF_ENABLED=true
ESIPF_REQUEST_SIGNING=false
ESIPF_RESPONSE_SIGNING=false
ESIPF_ENCRYPTED_BACKUP=true
ESIPF_AUTO_BACKUP=false
BACKUP_DIR=/data/backups
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_BACKUP_KEY
