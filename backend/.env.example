# Sarathi AI Backend — Environment Configuration
# Copy to .env and adjust per environment

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database (PostgreSQL with connection pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sarathi_ai
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=change_this_in_production_use_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Redis (optional — enables Redis cache when set)
# REDIS_URL=redis://localhost:6379

# Cache TTL (seconds)
CACHE_SESSION_TTL=3600
CACHE_KNOWLEDGE_TTL=1800
CACHE_AI_TTL=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500
RATE_LIMIT_AI_MAX=100

# AI Provider (Ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:0.5b
AI_TIMEOUT_MS=120000
AI_RETRY_ATTEMPTS=2

# Multi-LLM Provider Layer
AI_PRIMARY_PROVIDER=openai
AI_SECONDARY_PROVIDER=gemini
AI_EMERGENCY_FALLBACK=ollama
AI_FALLBACK_ORDER=openai,gemini,claude,ollama,lm-studio,local-llm
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# OpenAI
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Google Gemini
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# LM Studio / Local LLM
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model
LOCAL_LLM_URL=http://localhost:8080
LOCAL_LLM_MODEL=local

# Custom Provider
# CUSTOM_API_KEY=
# CUSTOM_API_URL=
# CUSTOM_MODEL=custom

# File Storage
STORAGE_ROOT=./storage

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Background Jobs
JOBS_ENABLED=true
MAINTENANCE_INTERVAL_MS=3600000
