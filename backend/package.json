{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/config/loadEnv.ts src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc",
    "start": "node --import ./dist/config/loadEnv.js dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync-tree": "node prisma/scripts/syncEngineeringTreeConfig.mjs",
    "db:generate": "prisma generate",
    "db:backup": "node scripts/backup-db.mjs",
    "lint": "tsc --noEmit",
    "governance": "node scripts/governance-check.mjs",
    "governance:report": "tsx -e \"import { generateGovernanceReport } from './src/governance/index.js'; const r = await generateGovernanceReport(); console.log(JSON.stringify(r, null, 2));\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.48.0",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vitest": "^3.0.5"
  }
}
