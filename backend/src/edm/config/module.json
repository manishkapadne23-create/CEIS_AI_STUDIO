{
  "version": "1.0.0",
  "schema": "sarathi-edm-module-v1",
  "module": {
    "id": "engineering-digital-memory",
    "name": "Engineering Digital Memory",
    "shortName": "EDM",
    "description": "Central intelligence repository for Sarathi AI engineering knowledge, standards, projects, and document metadata.",
    "apiBasePath": "/api/v1/edm"
  },
  "embedding": {
    "defaultModelId": "pending-model",
    "defaultDimensions": 1536,
    "statusOnRegister": "PENDING",
    "storage": "json",
    "futureProvider": "pgvector"
  },
  "search": {
    "defaultLimit": 25,
    "maxLimit": 100,
    "keywordStrategy": "postgresql-fts",
    "semanticStrategy": "cosine-json-vector"
  }
}
