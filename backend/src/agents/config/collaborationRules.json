      "toRoles": ["specialist"]
    },
    {
      "id": "recommend-alternative",
      "label": "Recommend an alternative approach",
      "fromRoles": ["specialist", "lead"],
      "toRoles": ["specialist", "lead"]
    }
  ],
  "validationPairs": [
    { "validator": "standards-expert", "validates": ["design-expert", "calculation-expert", "construction-expert"] },
    { "validator": "safety-expert", "validates": ["design-expert", "construction-expert"] },
    { "validator": "qa-qc-expert", "validates": ["design-expert", "construction-expert", "calculation-expert"] },
